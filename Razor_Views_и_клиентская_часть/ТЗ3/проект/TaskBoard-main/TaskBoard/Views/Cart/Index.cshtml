@model TaskBoard.Models.CartViewModel
@{
    ViewData["Title"] = "Корзина";
}

<h1 class="page-title">Корзина</h1>

@* ===== Задание 4. Alert при пустой корзине ===== *@
@if (Model.IsEmpty)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        Корзина пуста
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрыть"></button>
    </div>
    <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary">Перейти в каталог</a>
}
else
{
    @* ===== Задание 4. Alert после успешного оформления ===== *@
    @if (TempData["OrderSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["OrderSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрыть"></button>
        </div>
    }

    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Товар</th>
                <th class="text-end">Цена</th>
                <th class="text-center">Кол-во</th>
                <th class="text-end">Сумма</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Name</td>
                    <td class="text-end">@item.Price.ToString("C")</td>
                    <td class="text-center">@item.Quantity</td>
                    <td class="text-end">@item.Subtotal.ToString("C")</td>
                    <td class="text-end">
                        <form method="post" asp-controller="Cart" asp-action="Remove" asp-route-id="@item.ProductId" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">✕</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-end">Итого:</th>
                <th class="text-end">@Model.TotalAmount.ToString("C")</th>
                <th></th>
            </tr>
        </tfoot>
    </table>

    @* ===== Задание 5. Кнопка вызова модалки ===== *@
    <button type="button" class="btn btn-order btn-lg"
            data-bs-toggle="modal" data-bs-target="#confirmOrderModal">
        Оформить заказ
    </button>

    @* ===== Задание 5. Модальное окно подтверждения заказа ===== *@
    <div class="modal fade" id="confirmOrderModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" asp-controller="Cart" asp-action="Confirm">
                    @Html.AntiForgeryToken()

                    <div class="modal-header">
                        <h5 class="modal-title">Подтверждение заказа</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                    </div>

                    <div class="modal-body">
                        <p>
                            Вы уверены, что хотите оформить заказ на сумму
                            <strong>@Model.TotalAmount.ToString("C")</strong>?
                        </p>
                        <ul class="list-group mb-3">
                            @foreach (var item in Model.Items)
                            {
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>@item.Name × @item.Quantity</span>
                                    <span>@item.Subtotal.ToString("C")</span>
                                </li>
                            }
                        </ul>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                        <button type="submit" class="btn btn-order">Подтвердить</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}