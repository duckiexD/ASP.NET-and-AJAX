@{
    Layout = "_Layout";
}

@* Проброс секции PageHeader в базовый _Layout *@
@section PageHeader {
    @await RenderSectionAsync("PageHeader", required: false)
}

@* Средний уровень: проброс секции Actions в базовый _Layout *@
@section Actions {
    @await RenderSectionAsync("Actions", required: false)
}

<style>
    .app-layout {
        display: grid;
        grid-template-columns: 1fr 300px;
        gap: 20px;
    }

    .app-sidebar {
        background: #fff;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, .06);
        height: fit-content;
    }

    @@media (max-width: 900px) {
        .app-layout {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="app-layout">
    <div class="app-main">
        @RenderBody()
    </div>
    <aside class="app-sidebar">
        @await Component.InvokeAsync("TrendSummary")
    </aside>
</div>