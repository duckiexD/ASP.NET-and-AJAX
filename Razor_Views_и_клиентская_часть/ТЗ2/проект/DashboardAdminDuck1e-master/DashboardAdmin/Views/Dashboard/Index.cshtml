@model IEnumerable<DashboardCard>
@{
    ViewData["Title"] = "Дашборд";

    var cards = Model.ToList();
    decimal totalValue = cards.Sum(c => c.Value);
    int cardCount = cards.Count;
    int i = 0;

    // ✨ Сложный уровень: шаблонный делегат для рендеринга одной карточки
    Func<DashboardCard, Microsoft.AspNetCore.Html.IHtmlContent> renderCard =
        @<div class="card">
        <h3>@item.Title</h3>
        <div class="value @item.Trend.ToString().ToLower()">
            @GetTrendArrow(item.Trend) @item.Value.ToString("N0") @item.Unit
        </div>
        <div class="value-class">Уровень: @GetValueClass(item.Value)</div>
        <div class="trend-label">@GetTrendLabel(item.Trend)</div>
    @if (item.Value < 0)
    {
            <div class="badge-negative">Отрицательное значение</div>
    }
        <div class="description">@item.Description</div>
    </div>;

    // ✨ Сложный уровень: делегат-сводка по всем карточкам
    Func<IEnumerable<DashboardCard>, Microsoft.AspNetCore.Html.IHtmlContent> renderSummary =
        @<div class="summary">
        <div>Всего карточек: <b>@cards.Count</b></div>
        <div>Сумма значений: <b>@cards.Sum(c => c.Value).ToString("N0") @ViewBag.Currency</b></div>
        <div>Среднее значение: <b>@GetAverage(cards).ToString("N2") @ViewBag.Currency</b></div>
        <div>Период: <b>@ViewData["ReportPeriod"]</b></div>
    </div>;
}

@functions {
    string GetTrendLabel(Trend t) => t switch
    {
        Trend.Up => "Рост",
        Trend.Down => "Снижение",
        Trend.Stable => "Стабильно",
        _ => "—"
    };

    string GetTrendArrow(Trend t) => t switch
    {
        Trend.Up => "↑",
        Trend.Down => "↓",
        _ => "→"
    };

    // ✨ Лёгкий уровень: классификация значения
    string GetValueClass(decimal value)
    {
        if (value < 0) return "Отрицательное";
        if (value < 1000) return "Низкое";
        if (value <= 10000) return "Среднее";
        return "Высокое";
    }

    // ✨ Сложный уровень: среднее значение для renderSummary
    decimal GetAverage(IEnumerable<DashboardCard> cards)
    {
        var list = cards.ToList();
        return list.Count == 0 ? 0m : list.Average(c => c.Value);
    }
}

@section PageHeader {
    @* Данные за период из контроллера *@
    <h1>Дашборд</h1>
    <div class="subtitle">
        @cardCount показателей, сумма: @totalValue @ViewBag.Currency
        &middot; Период: @ViewData["ReportPeriod"]
    </div>
}

@* Средний уровень: секция Actions с кнопкой «Печать» *@
@section Actions {
    @if ((ViewData["Mode"] as string) != "Print")
    {
        <a href="/Dashboard/Print" class="btn">🖨 Печать</a>
    }
}

@*
    ─────────────────────────────────────────────────────────────
    ✨ Сложный уровень: пояснение про делегат vs partial

    Partial (@await Html.PartialAsync / <partial name="..." />):
      • отдельный файл .cshtml
      • переиспользуется между разными представлениями
      • типизируется через @model
      • требует диска и компиляции
      • не имеет доступа к локальным переменным страницы (кроме через модель)

    Шаблонный делегат (Func<..., IHtmlContent> x = @<div>...</div>):
      • объявляется прямо в текущем .cshtml
      • живёт только в пределах этого файла
      • видит @ViewBag, @ViewData, методы @functions, локальные переменные
      • удобен для одноразовой разметки рядом с логикой страницы

    Когда что использовать:
      • Partial — если фрагмент нужен в 2+ местах, или он сложный,
        или у него своя модель.
      • Делегат — если разметка нужна один раз и её хочется держать
        рядом с логикой страницы, не создавая отдельный файл.
    ─────────────────────────────────────────────────────────────
*@

<style>
    .cards-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
    }

    @@media (max-width: 1100px) {
        .cards-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 700px) {
        .cards-grid {
            grid-template-columns: 1fr;
        }
    }

    .card {
        background: #fff;
        border-radius: 10px;
        padding: 18px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, .06);
        transition: transform .15s;
    }

        .card:hover {
            transform: translateY(-3px);
        }

        .card h3 {
            margin: 0 0 8px;
            font-size: 15px;
            color: #7a869a;
            font-weight: 500;
        }

        .card .value {
            font-size: 22px;
            font-weight: 700;
        }

            .card .value.up {
                color: #27ae60;
            }

            .card .value.down {
                color: #e74c3c;
            }

            .card .value.stable {
                color: #2980b9;
            }

        .card .value-class {
            font-size: 12px;
            color: #7a869a;
            margin-top: 4px;
        }

        .card .trend-label {
            font-size: 13px;
            color: #7a869a;
            margin-top: 4px;
        }

        .card .description {
            font-size: 12px;
            color: #95a5a6;
            margin-top: 10px;
        }

    .badge-negative {
        display: inline-block;
        background: #fdecea;
        color: #c0392b;
        font-size: 11px;
        padding: 2px 8px;
        border-radius: 10px;
        margin-top: 8px;
    }

    .break {
        grid-column: 1 / -1;
        height: 0;
    }

    .summary {
        margin-top: 25px;
        padding: 15px 20px;
        background: #eaf2fb;
        border-radius: 10px;
        font-size: 14px;
        display: grid;
        gap: 6px;
    }

        .summary b {
            color: #1f2a44;
        }

    .page-actions {
        padding: 10px 30px;
        background: #f8fafc;
        border-bottom: 1px solid #e1e6ee;
        display: flex;
        gap: 10px;
    }

        .page-actions .btn {
            padding: 6px 14px;
            background: #1f2a44;
            color: #fff;
            text-decoration: none;
            border-radius: 6px;
            font-size: 13px;
        }

            .page-actions .btn:hover {
                background: #2c3e50;
            }
</style>

<div class="cards-grid">
    @foreach (var card in cards)
    {
        if (i > 0 && i % 3 == 0)
        {
            <div class="break"></div>
        }

        @* Сложный уровень: вызов делегата вместо partial *@
        @renderCard(card)

        i++;
    }
</div>

@* Сложный уровень: вызов делегата-сводки *@
@renderSummary(cards)